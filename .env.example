# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines: docker --env-file does not strip inline comments.
OPENAI_API_KEY=sk-your-key-here
JWT_SECRET=pick-a-long-random-string-at-least-32-characters
# production = refuse to start without JWT_SECRET
APP_ENV=development
# openai | stub (free deterministic model, used by the test suite)
TRIAGE_BACKEND=openai
